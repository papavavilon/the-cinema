Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteBase /dwp/
RewriteRule ^(?:app|includes|config|services|vendor|database|tests|docs|admin|frontend/(?:controllers|models|views))(?:/|$).*\.php$ - [F,L]
RewriteRule ^(?:includes|config|services|vendor|database|tests|docs)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?path=$1 [QSA,L]
